{
  "name": "claude-api-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "chunk": "tsx src/rag/chunkLessons.ts",
    "embed": "node --env-file=.env --import tsx src/rag/embeddings.ts",
    "store": "node --env-file=.env --import tsx src/rag/store.ts",
    "search": "node --env-file=.env --import tsx src/rag/search.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "voyageai": "^0.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
